spawn-at-startup "noctalia"

input {
    keyboard {
        xkb {
            layout "us"
        }
        // Niri's defaults (600 ms / 25 Hz) make held keys like j feel steppy.
        repeat-delay 250
        repeat-rate 50
    }

    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 8

    focus-ring {
        width 2
    }
}

overview {
    zoom 0.3
}

binds {
    // Essentials — a terminal and Noctalia's own app launcher (no separate
    // launcher binary needed; it's spawned at startup above).
    Mod+Return { spawn "alacritty"; }
    Mod+Space   { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+BackSpace { close-window; }
    Mod+Shift+E { quit; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // PaperWM-style navigation: Left/Right slide focus along the row of
    // columns, Up/Down move between workspaces stacked vertically.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-workspace-down; }
    Mod+Up    { focus-workspace-up; }

    // vim-style duplicates of the same four
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-workspace-down; }
    Mod+K { focus-workspace-up; }

    // Shift+direction moves the column/window instead of just focusing it
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down  { move-window-to-workspace-down; }
    Mod+Shift+Up    { move-window-to-workspace-up; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-to-workspace-down; }
    Mod+Shift+K { move-window-to-workspace-up; }

    // Column width / fullscreen, roughly PaperWM's width-cycling behavior
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }

    // Cycle preset column widths
    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    // Consume/expel the focused window into/out of the column to the side
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Floating windows
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Overview
    Mod+O repeat=false { toggle-overview; }

    Print { screenshot; }

    // Brightness keys (built-in panel, via brightnessctl)
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
}
